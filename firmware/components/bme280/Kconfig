menu "MESS I2C"

config MESS_I2C_PORT
    int "I2C port"
    range 0 1
    default 0

config MESS_I2C_SDA
    int "I2C SDA GPIO"
    range 0 33
    default 21

config MESS_I2C_SCL
    int "I2C SCL GPIO"
    range 0 33
    default 22

config MESS_I2C_SCAN_ONLY
    bool "Scan I2C once at boot and stop"
    default n

endmenu
